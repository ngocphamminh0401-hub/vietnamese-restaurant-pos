
import React, { useState } from 'react';
import { X, Search, PenLine, Plus, ArrowUpRight } from 'lucide-react';

interface AddExportModalProps {
    isOpen: boolean;
    onClose: () => void;
    onSave: (data: any) => void;
}

export const AddExportModal: React.FC<AddExportModalProps> = ({ isOpen, onClose, onSave }) => {
    const [form, setForm] = useState({
        reason: 'Khác',
        receiver: '',
        totalAmount: 0,
        note: ''
    });

    if (!isOpen) return null;

    const handleSubmit = () => {
        onSave({
            reason: form.reason,
            partnerName: form.receiver,
            totalAmount: form.totalAmount,
            note: form.note
        });
    };

    return (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
            <div className="bg-white rounded-lg shadow-xl w-full max-w-4xl h-[80vh] flex flex-col animate-in zoom-in-95 duration-200">
                <div className="flex justify-between items-center p-4 border-b border-gray-200 bg-orange-50 rounded-t-lg">
                    <h3 className="font-bold text-lg text-orange-800 flex items-center">
                        <ArrowUpRight size={20} className="mr-2"/> Tạo phiếu xuất kho
                    </h3>
                    <button onClick={onClose} className="text-gray-400 hover:text-gray-600"><X size={20}/></button>
                </div>
                
                <div className="flex flex-1 overflow-hidden">
                    {/* Left Side - Placeholder for Goods Selection */}
                    <div className="flex-1 bg-gray-50 p-6 border-r border-gray-200 flex flex-col items-center justify-center text-gray-400">
                        <div className="text-center">
                            <Plus size={48} className="mx-auto mb-4 opacity-20"/>
                            <p>Khu vực chọn hàng hóa xuất kho</p>
                            <p className="text-sm text-gray-400 mt-2">Chọn hàng từ danh mục hàng hóa</p>
                            
                            <div className="mt-8">
                                <label className="text-sm font-bold text-gray-600 block mb-2">Giả lập tổng giá trị xuất</label>
                                <input 
                                    type="number" 
                                    className="px-3 py-2 border rounded bg-white text-gray-800 font-bold text-center w-40"
                                    value={form.totalAmount}
                                    onChange={(e) => setForm({...form, totalAmount: Number(e.target.value)})}
                                    placeholder="0"
                                />
                            </div>
                        </div>
                    </div>

                    {/* Right Side - The Form */}
                    <div className="w-[400px] p-6 bg-white overflow-y-auto">
                        <div className="space-y-6">
                            
                            {/* Reason */}
                            <div>
                                <label className="block text-sm font-bold text-gray-700 mb-2">Lý do xuất kho</label>
                                <select 
                                    className="w-full px-3 py-2 border border-gray-300 rounded focus:ring-1 focus:ring-orange-500 outline-none text-sm bg-white"
                                    value={form.reason}
                                    onChange={(e) => setForm({...form, reason: e.target.value})}
                                >
                                    <option value="Hư hỏng / Hết hạn">Hư hỏng / Hết hạn</option>
                                    <option value="Sử dụng nội bộ">Sử dụng nội bộ (Bếp)</option>
                                    <option value="Trả hàng nhà cung cấp">Trả hàng nhà cung cấp</option>
                                    <option value="Điều chuyển kho">Điều chuyển kho</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            {/* Receiver */}
                            <div className="relative">
                                <label className="block text-sm font-bold text-gray-700 mb-2">Nơi nhận / Người nhận</label>
                                <input 
                                    type="text" 
                                    placeholder="Tên người nhận, Kho nhận, NCC..." 
                                    className="w-full px-3 py-2 border border-gray-300 rounded focus:ring-1 focus:ring-orange-500 outline-none text-sm"
                                    value={form.receiver}
                                    onChange={(e) => setForm({...form, receiver: e.target.value})}
                                />
                            </div>

                            {/* Export Info */}
                            <div className="bg-gray-50 p-4 rounded-lg border border-gray-100 space-y-3">
                                <div className="flex justify-between items-center">
                                    <label className="text-sm text-gray-600">Mã phiếu</label>
                                    <span className="text-sm font-bold text-gray-400">Mã tự động</span>
                                </div>
                                <div className="flex justify-between items-center">
                                    <label className="text-sm text-gray-600">Ngày tạo</label>
                                    <span className="text-sm font-bold text-gray-800">{new Date().toLocaleDateString('vi-VN')}</span>
                                </div>
                                <div className="flex justify-between items-center pt-2 border-t border-gray-200">
                                    <label className="text-sm font-bold text-gray-800">Tổng giá trị</label>
                                    <span className="text-lg font-black text-orange-600">{form.totalAmount.toLocaleString()}</span>
                                </div>
                            </div>

                            {/* Note */}
                            <div className="relative">
                                <label className="block text-sm font-bold text-gray-700 mb-2">Ghi chú</label>
                                <div className="relative">
                                    <PenLine size={14} className="absolute left-3 top-3 text-gray-400"/>
                                    <textarea 
                                        className="w-full pl-9 pr-3 py-2 border border-gray-300 rounded text-sm outline-none focus:ring-1 focus:ring-orange-500 min-h-[80px]"
                                        placeholder="Ghi chú thêm..."
                                        value={form.note}
                                        onChange={(e) => setForm({...form, note: e.target.value})}
                                    ></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div className="p-4 border-t border-gray-200 bg-gray-50 flex justify-end gap-3 rounded-b-lg">
                    <button onClick={onClose} className="px-6 py-2 bg-gray-500 text-white font-bold rounded hover:bg-gray-600 transition">Hủy bỏ</button>
                    <button onClick={handleSubmit} className="px-6 py-2 bg-orange-600 text-white font-bold rounded hover:bg-orange-700 transition flex items-center shadow-sm">
                        Hoàn thành phiếu xuất
                    </button>
                </div>
            </div>
        </div>
    );
};
